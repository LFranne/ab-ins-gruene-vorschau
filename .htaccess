# Apache-Regeln für ALL-INKL (liegt im Hauptordner der Seite).

RewriteEngine On

# Immer verschlüsselt und ohne www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ab-ins-gruene.net%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  # wetter.json ändert sich stündlich, nie zwischenspeichern
  <Files "wetter.json">
    Header set Cache-Control "no-cache"
  </Files>
  # HTML immer neu prüfen, Bilder, Schriften und Videos lange behalten
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff2|mp4|webm|js|css)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
